( Every arithmetic operator on two numbers from the input:
  prints a PLUS b, a MINUS b, a TIMES b, a DIV b and a MOD b.

  input:  7 3
  output: 10 4 21 2 1
  input:  -7 3
  output: -4 -10 -21 -3 2
  input:  7 -3
  output: 4 10 -21 -3 -2
  input:  -7 -3
  output: -10 -4 21 2 -1
  input:  0 5
  output: 5 -5 0 0 0
  input:  5 0
  output: 5 5 0 0 0
  input:  123456789 -987654
  output: 122469135 124444443 -121932591483006 -126 -987615
  input:  -1000000007 1000000009
  output: 2 -2000000016 -1000000016000000063 -1 2
)
VAR
    a, b, c
BEGIN
    READ a;
    READ b;
    c ASSIGN a PLUS b;
    WRITE c;
    c ASSIGN a MINUS b;
    WRITE c;
    c ASSIGN a TIMES b;
    WRITE c;
    c ASSIGN a DIV b;
    WRITE c;
    c ASSIGN a MOD b;
    WRITE c;
END
