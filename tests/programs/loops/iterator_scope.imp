( A FOR iterator is local to its loop. It may reuse the name of a variable or of an outer
  iterator; the name then refers to the iterator until the end of the loop.

  output: 100 6 10 11 1 10 11 2
)
VAR
    i, s
BEGIN
    i ASSIGN 100;
    s ASSIGN 0;
    FOR i FROM 1 TO 3 DO
        s ASSIGN s PLUS i;
    ENDFOR
    WRITE i;
    WRITE s;

    FOR j FROM 1 TO 2 DO
        FOR j FROM 10 TO 11 DO
            WRITE j;
        ENDFOR
        WRITE j;
    ENDFOR
END
